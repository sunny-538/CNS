/*Start

Input plaintext and key

Arrange plaintext into a 4×4 state matrix

Perform these rounds:

SubBytes

ShiftRows

MixColumns (except final round)

AddRoundKey

Final round (without MixColumns)

Output ciphertext

Stop*/

import javax.crypto.Cipher;
import javax.crypto.spec.SecretKeySpec;
import java.util.Base64;

class AESDemo {
    public static void main(String[] args) throws Exception {
        String plain = "HELLO1234567890";
        String key   = "ABCDEFGHIJKLMNOP"; // 16 chars = 128-bit key

        // Create AES key
        SecretKeySpec ks = new SecretKeySpec(key.getBytes(), "AES");

        // Explicitly specify mode + padding
        Cipher c = Cipher.getInstance("AES/ECB/PKCS5Padding");

        // Encrypt
        c.init(Cipher.ENCRYPT_MODE, ks);
        byte[] enc = c.doFinal(plain.getBytes());

        // Decrypt
        c.init(Cipher.DECRYPT_MODE, ks);
        byte[] dec = c.doFinal(enc);

        // Encode ciphertext properly
        String encBase64 = Base64.getEncoder().encodeToString(enc);

        System.out.println("Plain text      : " + plain);
        System.out.println("Encrypted (B64) : " + encBase64);
        System.out.println("Decrypted text  : " + new String(dec));
    }
}
